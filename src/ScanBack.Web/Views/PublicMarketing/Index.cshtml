@model PublicMarketingPage
@{ var greek = Model.IsGreek; var home = "/" + Model.Seo.Language; }
<section class="hero-section">
    <div class="hero-copy">
        <div class="eyebrow"><span class="status-dot"></span>@T["FOR RIDERS. FOR THE PEOPLE WHO CARE."]</div>
        <h1>@(greek ? "Το προφίλ σας." : "Your emergency profile.")<br /><span>@(greek ? "Ένα QR μακριά." : "One scan away.")</span></h1>
        <p class="hero-description">@Model.Introduction</p>
        <div class="hero-actions"><a class="btn btn-primary btn-lg" href="/account/register">@T["Create my rider profile"] <svg class="inline-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 15 15 5M5 5h10v10" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg></a><a class="hero-secondary" href="#how-it-works">@T["See how it works"] <span aria-hidden="true">↓</span></a></div>
        <div class="hero-reassurance"><span><span class="check-circle" aria-hidden="true">✓</span>@T["No app to install"]</span><span><span class="check-circle" aria-hidden="true">✓</span>@T["You control what is shared"]</span></div>
    </div>
    <div class="hero-art" aria-label="@T["A helmet sticker connects to an emergency profile"]" role="img">
        <div class="art-grid"></div>
        <span class="art-label">@T["A SMALL STICKER. A BIG CONNECTION."]</span>
        <svg class="helmet-illustration" viewBox="0 0 640 590" aria-hidden="true">
            <defs>
                <linearGradient id="helmetBody" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#f5f4ee"/><stop offset="0.44" stop-color="#c6cec7"/><stop offset="1" stop-color="#78867d"/></linearGradient>
                <linearGradient id="helmetVisor" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#4d665d"/><stop offset="0.5" stop-color="#253b35"/><stop offset="1" stop-color="#101e19"/></linearGradient>
                <linearGradient id="chin" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#c5cec6"/><stop offset="1" stop-color="#8a9990"/></linearGradient>
                <filter id="shadow"><feGaussianBlur stdDeviation="13"/></filter>
            </defs>
            <ellipse cx="322" cy="480" rx="183" ry="23" fill="#070d09" opacity=".45" filter="url(#shadow)"/>
            <path d="M123 330c-15-100 28-214 126-248 64-23 144-13 201 29 53 39 85 98 85 166 0 68-26 148-67 175-30 20-51 29-118 25l-169-9c-37-3-48-45-40-79z" fill="url(#helmetBody)" stroke="#e5ece4" stroke-opacity=".5" stroke-width="2"/>
            <path d="M183 218c50-36 215-55 318-17 17 7 28 24 26 44-3 37-11 75-35 102-94 10-193-2-286-18-23-5-42-91-23-111z" fill="url(#helmetVisor)" stroke="#152720" stroke-width="7"/>
            <path d="M205 227c65-29 189-35 271-13" stroke="#bccdc4" stroke-width="5" stroke-linecap="round" opacity=".25"/>
            <path d="m195 336 40 95 154 3c25 0 42-13 47-34l-55-46z" fill="#26382f"/>
            <path d="M143 354c43-9 89-6 122 24l19 39 180 11c-5 39-38 51-103 50l-174-10c-41-1-49-49-44-114z" fill="url(#chin)"/>
            <path d="m291 445 114 4-9 15-96-5z" fill="#42544a"/>
            <path d="M155 349c-5-80 19-178 85-222" fill="none" stroke="#f7fff8" stroke-opacity=".32" stroke-width="8" stroke-linecap="round"/>
            <path d="m334 95 48 6 17 21-66-10z" fill="#26382f"/>
            <path d="m348 100 24 2 11 10-37-5z" fill="#111e17"/>
            <circle cx="169" cy="287" r="26" fill="#7f8e84" stroke="#e0e8df" stroke-width="3"/><circle cx="169" cy="287" r="15" fill="#a5b1a8"/><path d="m162 288 14-2" stroke="#4e6356" stroke-width="4"/>
            <g transform="translate(168 370) rotate(8)">
                <rect x="0" y="0" width="69" height="73" rx="8" fill="#171d1b"/><rect x="7" y="7" width="55" height="49" rx="4" fill="#cdf87f"/>
                <g fill="#171d1b"><path d="M13 13h15v15H13zm23 0h15v15H36zM13 34h15v15H13z"/><path d="M32 32h5v5h-5zm11 0h5v10h-5zm-11 11h10v5H32zm18-2h5v8h-5z"/></g>
                <g fill="#cdf87f"><rect x="17" y="17" width="7" height="7"/><rect x="40" y="17" width="7" height="7"/><rect x="17" y="38" width="7" height="7"/></g>
                <text x="34" y="65" font-size="7" font-family="Arial,sans-serif" font-weight="bold" text-anchor="middle" fill="#f0f4ec">SCANBACK</text>
            </g>
            <path d="M205 410c82 20 113 46 160 15" fill="none" stroke="#cdf87f" stroke-width="2" stroke-dasharray="6 7"/>
        </svg>
        <div class="connection-badge"><span class="signal-icon" aria-hidden="true"><svg class="inline-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 15 15 5M5 5h10v10" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg></span><div><strong>@T["Scan. Connect. Help."]</strong><span>@T["QR + NFC. One emergency page."]</span></div></div>
        <span class="art-coordinate" aria-hidden="true">37°58′ N · 23°43′ E</span>
    </div>
</section>
<div class="trust-strip"><span>@T["BUILT AROUND THE MOMENTS THAT MATTER"]</span><div>@T["Browser based"]</div><div>@T["Greek & English"]</div><div>@T["112 / 166 quick access"]</div><div>@T["Privacy by choice"]</div></div>
<section class="section-wrap" id="how-it-works">
    <div class="section-heading"><div><span class="eyebrow">@T["SIMPLE BY DESIGN"]</span><h2>@T["Ready in three steps."]</h2></div><p>@T["A few minutes of preparation can help someone reach the right information and the right people."]</p></div>
    <div class="steps-grid">
        <article class="step-card"><span class="step-number">01</span><div class="step-icon" aria-hidden="true">♡</div><h3>@T["Build your profile"]</h3><p>@T["Add essential medical details and trusted contacts. Choose exactly what appears on your emergency page."]</p></article>
        <article class="step-card"><span class="step-number">02</span><div class="step-icon" aria-hidden="true">▦</div><h3>@T["Connect your helmet"]</h3><p>@T["Download your QR sticker or copy the same secure link to an NFC tag. No medical information is stored on the sticker."]</p></article>
        <article class="step-card"><span class="step-number">03</span><div class="step-icon" aria-hidden="true"><svg class="inline-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 15 15 5M5 5h10v10" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg></div><h3>@T["Make help easier"]</h3><p>@T["A scan opens your emergency page. A helper can call emergency services and report a possible accident to your contacts."]</p></article>
    </div>
</section>
<section class="privacy-section section-wrap" id="privacy-first">
    <div class="privacy-copy"><span class="eyebrow">@T["YOUR INFORMATION. YOUR CHOICE."]</span><h2>@T["Share what helps."]<br />@T["Keep the rest private."]</h2><p>@T["Medical information is private by default. You decide what a person scanning your sticker can see, and you can change or revoke access at any time."]</p><ul class="feature-checks"><li>@T["Preview your public emergency profile"]</li><li>@T["Replace or deactivate a lost sticker"]</li><li>@T["Location is shared only with permission"]</li><li>@T["Export or delete your personal data"]</li></ul><a class="text-link" href="/privacy">@T["Understand how your data is used"] <svg class="inline-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 15 15 5M5 5h10v10" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg></a></div>
    <div class="sample-profile"><div class="sample-top"><span class="tiny-label">@T["EMERGENCY PROFILE"]</span><span class="badge badge-muted">@T["Illustrative example"]</span></div><div class="sample-person"><span class="sample-avatar" aria-hidden="true">AR</span><div><h3>@T["Alex Rider"]</h3><p>@T["Shared information only"]</p></div><span class="sample-shield" aria-hidden="true">✓</span></div><div class="sample-facts"><div><span>@T["ALLERGIES"]</span><strong>@T["Example: penicillin"]</strong></div><div><span>@T["EMERGENCY CONTACT"]</span><strong>@T["A trusted person"]</strong></div></div><div class="sample-call"><span class="phone-symbol" aria-hidden="true"><svg class="inline-icon" viewBox="0 0 20 20" fill="none"><path d="m6 2-3 2c-1 4 2 10 7 13 3 2 5 1 7-2l-4-3-2 2c-3-1-5-3-6-6l2-2Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" /></svg></span><div><strong>112</strong><span>@T["Emergency services"]</span></div><span aria-hidden="true">→</span></div><p class="sample-note">@T["Demonstration only. No real rider information."]</p></div>
</section>
<section class="start-banner section-wrap"><div><span class="eyebrow">@T["THE NEXT RIDE STARTS HERE"]</span><h2>@T["Put your safety network in place."]</h2><p>@T["Start with a profile. Keep it ready for the road."]</p></div><a class="btn btn-primary btn-lg" href="/account/register">@T["Create my rider profile"] <svg class="inline-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 15 15 5M5 5h10v10" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg></a></section>

<section class="section-wrap" aria-labelledby="rider-resources">
    <div class="section-heading"><div><span class="eyebrow">@(greek ? "ΠΡΙΝ ΑΠΟ ΤΗ ΔΙΑΔΡΟΜΗ" : "BEFORE THE RIDE")</span><h2 id="rider-resources">@(greek ? "QR, NFC και σωστή προετοιμασία." : "QR, NFC and a little preparation.")</h2></div></div>
    <div class="steps-grid marketing-resource-grid">
        <article class="step-card"><h3>@(greek ? "Πώς λειτουργεί το ScanBack" : "How ScanBack works")</h3><p>@(greek ? "Δημιουργήστε προφίλ, επιλέξτε ορατά στοιχεία και προσκαλέστε τις επαφές σας να δώσουν άδεια." : "Build a profile, choose visible fields and invite your contacts to give their permission.")</p><a class="text-link" href="@(home + "/how-it-works")">@(greek ? "Δείτε τα βήματα" : "Explore the steps") <span aria-hidden="true">→</span></a></article>
        <article class="step-card"><h3>@(greek ? "Αυτοκόλλητα QR και NFC" : "QR and NFC helmet stickers")</h3><p>@(greek ? "Τι περιέχει ο σύνδεσμος, πώς τον δοκιμάζετε και τι κάνετε αν χαθεί το αυτοκόλλητο." : "Understand what the link contains, how to test it and what to do if your sticker is lost.")</p><a class="text-link" href="@(home + "/qr-nfc-helmet-stickers")">@(greek ? "Οδηγός αυτοκόλλητων" : "Read the sticker guide") <span aria-hidden="true">→</span></a></article>
        <article class="step-card"><h3>@(greek ? "Έκτακτη ανάγκη στην Ελλάδα" : "Emergency preparation in Greece")</h3><p>@(greek ? "Γνωρίστε το 112 και το 166 και οργανώστε τις πληροφορίες που θα χρειαστεί ο τηλεφωνητής." : "Know 112 and 166, and prepare the facts an emergency dispatcher may need.")</p><a class="text-link" href="@(home + "/motorcycle-emergency-guide")">@(greek ? "Οδηγός προετοιμασίας" : "Read the preparation guide") <span aria-hidden="true">→</span></a></article>
    </div>
    <p class="marketing-home-note">@(greek ? "Η σάρωση ή η αναφορά δεν καλεί υπηρεσίες έκτακτης ανάγκης. Σε επείγον περιστατικό, καλέστε απευθείας" : "A scan or report does not call emergency services. If someone needs urgent help, call directly:") <a href="tel:112">112</a> · <a href="tel:166">166 (ΕΚΑΒ)</a>.</p>
</section>
