@model ResetPasswordModel
@{ ViewData["Title"] = T["Set a new password"]; }
<section class="auth-shell compact"><div class="card auth-card"><h1>@T["Set a new password"]</h1><form asp-action="ResetPassword" method="post"><input asp-for="Code" type="hidden" />
<div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
<div class="form-field"><label asp-for="Email">@T["Email address"]</label><input asp-for="Email" autocomplete="email" /><span asp-validation-for="Email"></span></div>
<div class="form-field"><label asp-for="Password">@T["New password"]</label><input asp-for="Password" autocomplete="new-password" /><span asp-validation-for="Password"></span><p class="field-help">@T["Use at least 12 characters with uppercase, lowercase, a number and a symbol."]</p></div>
<div class="form-field"><label asp-for="ConfirmPassword">@T["Confirm password"]</label><input asp-for="ConfirmPassword" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword"></span></div><button class="btn btn-primary" type="submit">@T["Change password"]</button></form></div></section>
