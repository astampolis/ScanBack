@model RegisterModel
@inject Microsoft.Extensions.Options.IOptions<ScanBack.Infrastructure.Hosting.PrivacyOptions> Privacy
@{ ViewData["Title"] = T["Create your account"]; }
<section class="auth-shell"><div class="auth-intro"><span class="eyebrow">SCANBACK</span><h1>@T["Ride with confidence."]</h1><p>@T["Give helpers the information you choose to share, when it matters most."]</p></div><div class="card auth-card">
<h2>@T["Create your account"]</h2><p class="text-muted">@T["Your profile starts private. You decide what a helmet scan reveals."]</p>
<form asp-action="Register" method="post">
<input type="hidden" name="privacyPolicyVersion" value="@Privacy.Value.PolicyVersion" />
<div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
<div class="form-field"><label asp-for="FullName">@T["Full name"]</label><input asp-for="FullName" autocomplete="name" maxlength="180" /><span asp-validation-for="FullName"></span></div>
<div class="form-field"><label asp-for="Email">@T["Email address"]</label><input asp-for="Email" autocomplete="email" /><span asp-validation-for="Email"></span></div>
<div class="form-field"><label asp-for="Password">@T["Password"]</label><input asp-for="Password" autocomplete="new-password" /><span asp-validation-for="Password"></span><p class="field-help">@T["Use at least 12 characters with uppercase, lowercase, a number and a symbol."]</p></div>
<div class="form-field"><label asp-for="ConfirmPassword">@T["Confirm password"]</label><input asp-for="ConfirmPassword" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword"></span></div>
<label class="check-label"><input asp-for="PrivacyAccepted" /> <span>@T["I have read and accept the"] <a href="/privacy">@T["privacy notice"]</a> (@Privacy.Value.PolicyVersion).</span></label><span asp-validation-for="PrivacyAccepted"></span>
<button class="btn btn-primary w-100" type="submit">@T["Create account"]</button>
</form><p class="auth-foot">@T["Already registered?"] <a asp-action="Login">@T["Sign in"]</a></p></div></section>
