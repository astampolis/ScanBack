@model TwoFactorModel
@{ ViewData["Title"] = T["Two-factor verification"]; }
<section class="auth-shell compact"><div class="card auth-card"><h1>@T["Two-factor verification"]</h1><p>@T["Enter the code from your authenticator app, or use one unused recovery code."]</p><form asp-action="TwoFactor" method="post"><input asp-for="ReturnUrl" type="hidden" /><input asp-for="RememberMe" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div><div class="form-field"><label asp-for="Code">@T["Verification or recovery code"]</label><input asp-for="Code" autocomplete="one-time-code" maxlength="100" autofocus /><span asp-validation-for="Code"></span></div><label class="check-label"><input asp-for="UseRecoveryCode" /> @T["This is a recovery code"]</label><button class="btn btn-primary" type="submit">@T["Verify and sign in"]</button></form></div></section>
