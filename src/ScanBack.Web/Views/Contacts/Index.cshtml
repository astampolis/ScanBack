@model List<EmergencyContact>
@{ ViewData["Title"] = T["Emergency contacts"]; }
<div class="page-header"><div><span class="eyebrow">@T["YOUR TRUSTED PEOPLE"]</span><h1>@T["Emergency contacts"]</h1><p>@T["Choose the people who should hear when someone reports a possible accident."]</p></div><a class="btn btn-primary" asp-action="Create">@T["Add contact"]</a></div>
<section class="card"><p>@T["Contacts must confirm their email before notifications can be sent. Emails are private. Public phone numbers also require contact visibility in your profile."]</p></section>
@if (Model.Count == 0) { <section class="card empty-state"><div class="empty-icon" aria-hidden="true">♡</div><h2>@T["Your trusted people belong here"]</h2><p>@T["Add your first emergency contact and ask them to confirm their email."]</p><a class="btn btn-primary" asp-action="Create">@T["Add contact"]</a></section> }
else { <div class="contact-grid">@foreach (var contact in Model) { <section class="card contact-card"><div class="card-heading"><div><h2>@contact.Name</h2><p class="text-muted">@contact.Relationship</p></div><span class="badge @(contact.IsVerified && contact.NotifyEnabled ? "badge-success" : "badge-warning")">@(contact.IsVerified && contact.NotifyEnabled ? T["Ready to notify"] : !contact.NotificationsRequested ? T["Notifications off"] : T["Awaiting confirmation"])</span></div><dl class="detail-list"><dt>@T["Email address"]</dt><dd>@contact.Email <span class="badge badge-muted">@T["Private"]</span></dd><dt>@T["Phone"]</dt><dd>@(string.IsNullOrWhiteSpace(contact.Phone) ? T["Not provided"] : contact.Phone) <span class="badge badge-muted">@(contact.PublicPhone ? T["May be public"] : T["Private"])</span></dd></dl><div class="form-actions"><a class="btn btn-outline" asp-action="Edit" asp-route-id="@contact.Id">@T["Edit"]</a><a class="btn btn-danger-outline" asp-action="Delete" asp-route-id="@contact.Id">@T["Remove"]</a>@if ((contact.NotificationsRequested && (!contact.IsVerified || !contact.NotifyEnabled)) || (contact.PublicPhoneRequested && !contact.PublicPhone)) { <form asp-action="Resend" asp-route-id="@contact.Id" method="post"><button class="btn btn-outline" type="submit">@T["Resend confirmation"]</button></form> }</div></section> }</div> }
