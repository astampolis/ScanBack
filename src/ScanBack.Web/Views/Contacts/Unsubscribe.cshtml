@model ContactTokenModel
@{ ViewData["Title"] = T["Stop emergency notifications"]; }
<section class="auth-shell compact"><div class="card auth-card"><h1>@T["Stop emergency notifications"]</h1>@if (Model.Valid) { <p>@T["Stop notifications for"] <strong>@Model.RiderName</strong>?</p><p>@T["Your email notifications and public phone visibility will be disabled. Existing incident invitations will be revoked."]</p><form asp-action="UnsubscribeConfirmed" asp-route-token="@Model.Token" method="post"><button class="btn btn-danger" type="submit">@T["Stop notifications and public phone sharing"]</button></form> } else { <p>@T["This link is invalid or the contact has been removed."]</p> }</div></section>
