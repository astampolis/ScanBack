@model ContactTokenModel
@{ ViewData["Title"] = T["Confirm emergency contact"]; }
<section class="auth-shell compact"><div class="card auth-card"><h1>@T["Confirm emergency contact"]</h1>@if (Model.Valid) { <p><strong>@Model.RiderName</strong> @T["has invited you to be an emergency contact."]</p><p>@T["Confirming allows ScanBack to email you when someone reports a possible accident for this rider. A report is not independently verified and does not contact emergency services."]</p><form asp-action="VerifyConfirmed" asp-route-token="@Model.Token" method="post"><button class="btn btn-primary" type="submit">@T["Confirm my email and participation"]</button></form> } else { <p>@T["This invitation is invalid, expired, or already used. Ask the rider to send a new confirmation email."]</p> }</div></section>
