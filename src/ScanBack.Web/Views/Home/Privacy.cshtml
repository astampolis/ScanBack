@model ScanBack.Infrastructure.Hosting.PrivacyOptions
@{ ViewData["Title"] = T["Privacy & data"]; }
<article class="policy-page">
    <div class="page-header"><span class="eyebrow">@T["YOUR INFORMATION. YOUR CHOICE."]</span><h1>@T["Privacy & data"]</h1><p>@T["How this application handles rider profiles and emergency reports."]</p></div>
    <section class="card"><h2>@T["Data controller and privacy contact"]</h2><p>@string.Format(T["{0} operates this ScanBack service. Contact"], Model.ControllerName) <a href="mailto:@Model.ContactEmail">@Model.ContactEmail</a> @T["about your personal data, a correction, a privacy concern or a rights request. Notice version:"] @Model.PolicyVersion.</p></section>
    <section class="card"><h2>@T["What is collected"]</h2><p>@T["Your account contains your email address and login information. Your rider profile may contain identification, health details, instructions, a photo and emergency contacts that you choose to provide. Health information requires explicit consent before it is saved."]</p><p>@T["We process account and ordinary profile details to provide the service you request under GDPR Article 6(1)(b). Optional health information, including information you choose to make public, is processed on your explicit consent under Articles 6(1)(a) and 9(2)(a). Security controls, limited administrative audit records and abuse prevention serve the legitimate interests of protecting the service and its users under Article 6(1)(f); you may ask the controller about this assessment and object to that processing. We do not sell personal data or use health information for advertising or automated decisions."]</p></section>
    <section class="card"><h2>@T["What a sticker scan reveals"]</h2><p>@T["A QR or NFC sticker contains a random URL, not medical information. Anyone with that URL, including someone who photographs your sticker, can view the fields you choose to publish. Medical fields are private by default. The profile preview lets you check the shared information. Deactivating or replacing the sticker stops future access through that identifier."]</p><p>@T["Publishing a health field deliberately discloses special-category health data to people who have your sticker link, including strangers. They can copy what they see. Withdrawing consent stops future display and deletes the stored health fields; it cannot retrieve copies someone has already made. Only publish information you intend to make available in this way."]</p></section>
    <section class="card"><h2>@T["Emergency contacts"]</h2><p>@T["You may provide contact details for someone who can help in an emergency. Ask them first and provide current details. A verification message lets the recipient choose whether to participate. Notifications require recipient confirmation; public display of their telephone number requires their separate, explicit permission. Contact email addresses are never published. Recipients can decline or withdraw using the link in their invitation. Removing a contact or withdrawing their participation revokes their incident invitations."]</p></section>
    <section class="card"><h2>@T["Accident reports and location"]</h2><p>@T["Opening a profile does not report an accident or request location. A helper must explicitly submit a possible accident report. Browser location is requested only after the helper chooses to share it. Reporting remains available if location permission is denied. Reports are unverified and do not contact public emergency dispatch systems."]</p><p>@T["Reports may contain the location, reporter-supplied description, consciousness status and number of people involved. They are shared only through the incident access granted to the reporter and participating emergency contacts. Do not include unnecessary sensitive information about other people."]</p></section>
    <section class="card"><h2>@T["Notifications and incident access"]</h2><p>@string.Format(T["Participating contacts can receive an email invitation to an incident. Emails contain an invitation and a general alert, without the rider's medical information or precise location. An invitation is exchanged once for a secure browser cookie scoped to that incident. Access expires after {0} hours by default and may be revoked sooner. Do not forward invitations. Queued or mail-server-accepted status does not prove a person read a message."], ViewData["IncidentAccessHours"])</p></section>
    <section class="card"><h2>@T["Retention and your choices"]</h2><p>@string.Format(T["Incidents and associated invitations are removed after the current {0}-day retention period, once their access has expired. Older notification and audit records are also removed by scheduled cleanup. Cleanup runs periodically, so expiry blocks access before physical deletion completes. Settings changes can alter these periods for retained records."], ViewData["IncidentRetentionDays"])</p><p>@T["Your account and profile remain while your account is open. You can edit your data, change visibility, remove contacts, revoke or replace stickers, download your data and delete your account in your profile. Withdrawing health consent immediately deletes health fields and clears their public visibility. Consent withdrawal does not affect processing that was lawful before withdrawal. Account deletion removes active account data and unlinks retained audit events; separate backup copies expire under the operator's backup policy. Contact the controller for backup-retention details."]</p></section>
    <section class="card"><h2>@T["Your rights"]</h2><p>@string.Format(T["You can request access, correction, erasure, restriction or a portable copy of your data, and object to processing based on legitimate interests. Where processing relies on consent, you can withdraw it at any time. Contact {0} if self-service controls do not meet your request, including when you are an emergency contact without an account. We may need proportionate identity verification to avoid disclosing data to another person. We respond without undue delay, normally within one month; a complex request may allow an extension of up to two additional months, with an explanation within the first month. You may complain to the supervisory authority in your country of residence, work or the alleged infringement."], Model.ContactEmail)</p></section>
    <section class="card"><h2>@T["Keeping data secure"]</h2><p>@T["Account pages require authentication and ownership checks. Administrators manage account status, settings and limited incident metadata through an interface that does not display medical profiles. Profile health fields and queued email bodies are protected in the database. Necessary hosting and mail providers process data to run the service; contact the controller for the current providers, processing locations, international transfers and applicable safeguards. People with legitimate operational access may need to investigate service or security incidents."]</p></section>
    <section class="card"><h2>@T["Cookies and outside services"]</h2><p>@T["The application uses necessary authentication, incident-access, request-security and language-preference cookies. Assets are hosted locally and the application includes no advertising or analytics trackers. Email uses the operator's configured mail service. Opening a map link or initiating a telephone call invokes the provider or device you choose. The service does not continuously track your location or send your data to an AI service."]</p></section>
    <a href="/profile" class="btn btn-primary">@T["Manage my data"] <span aria-hidden="true">→</span></a>
</article>
