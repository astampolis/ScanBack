@model DeleteAccountModel
@{ ViewData["Title"] = T["Delete your account"]; }
<div class="page-header"><div><h1>@T["Delete your account"]</h1><p>@T["This action permanently removes your active personal data."]</p></div></div><section class="card danger-zone"><h2>@T["Before you continue"]</h2><p>@T["Your profile, photo, contacts, stickers, incidents and invitations will be removed. Existing QR and NFC stickers will stop working. Backup copies expire according to the hosting retention policy."]</p><p><a href="/profile/export">@T["Download your data first"]</a></p><form asp-action="Delete" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div><div class="form-field"><label asp-for="Password">@T["Confirm your current password"]</label><input asp-for="Password" autocomplete="current-password" /><span asp-validation-for="Password"></span></div><label class="check-label"><input asp-for="ConfirmDeletion" /> @T["I understand that my account and active personal data will be permanently deleted."]</label><span asp-validation-for="ConfirmDeletion"></span><div class="form-actions"><button class="btn btn-danger" type="submit">@T["Permanently delete account"]</button><a class="btn btn-outline" href="/profile">@T["Cancel"]</a></div></form></section>
