@model ProfileEditModel
@inject Microsoft.Extensions.Options.IOptions<ScanBack.Infrastructure.Hosting.PrivacyOptions> Privacy
@{ ViewData["Title"] = T["Edit emergency profile"]; }
<div class="page-header"><div><span class="eyebrow">@T["YOUR INFORMATION"]</span><h1>@T["Edit emergency profile"]</h1><p>@T["Keep essential details current. All fields stay private unless you publish them below."]</p></div><a class="btn btn-outline" href="/profile">@T["Back to dashboard"]</a></div>
<form asp-action="Edit" method="post" enctype="multipart/form-data">
<input type="hidden" name="consentPolicyVersion" value="@Privacy.Value.PolicyVersion" />
<div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
<section class="card"><h2>@T["Personal details"]</h2><div class="form-grid">
<div class="form-field"><label asp-for="FullName">@T["Full name"]</label><input asp-for="FullName" autocomplete="name" maxlength="180" /><span asp-validation-for="FullName"></span></div>
<div class="form-field"><label asp-for="DateOfBirth">@T["Date of birth"]</label><input asp-for="DateOfBirth" type="date" /><span asp-validation-for="DateOfBirth"></span><p class="field-help">@T["Only age is shown if you publish it. Your full birth date stays private."]</p></div>
<div class="form-field"><label asp-for="Photo">@T["Profile photo (optional)"]</label><input asp-for="Photo" type="file" accept="image/jpeg,image/png" /><span asp-validation-for="Photo"></span><p class="field-help">@T["JPEG or PNG, up to 2 MB and 4096 pixels per side. Photo metadata is removed. Your photo stays private unless you publish it."]</p>@if (Model.HasPhoto) { <img src="/profile/photo" alt="@T["Your current profile photo"]" class="rider-avatar" /><label class="check-label"><input asp-for="RemovePhoto" /> @T["Remove current photo"]</label><span asp-validation-for="RemovePhoto"></span> }</div>
</div></section>
<section class="card"><h2>@T["Emergency medical information"]</h2><p class="field-help">@T["Enter only information that could help responders. These details are rider supplied and are not independently verified."]</p><div class="form-grid">
<div class="form-field"><label asp-for="BloodType">@T["Blood type"]</label><select asp-for="BloodType"><option value="">@T["Unknown / not provided"]</option>@foreach (var blood in new[] { "A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-" }) { <option value="@blood">@blood</option> }</select><span asp-validation-for="BloodType"></span><p class="field-help">@T["Only enter a blood type you know. Responders must verify it clinically."]</p></div>
<div class="form-field"><label asp-for="Allergies">@T["Allergies"]</label><textarea asp-for="Allergies" rows="3" maxlength="2000"></textarea><span asp-validation-for="Allergies"></span></div>
<div class="form-field"><label asp-for="Conditions">@T["Medical conditions"]</label><textarea asp-for="Conditions" rows="3" maxlength="2000"></textarea><span asp-validation-for="Conditions"></span></div>
<div class="form-field"><label asp-for="Medications">@T["Current medications"]</label><textarea asp-for="Medications" rows="3" maxlength="2000"></textarea><span asp-validation-for="Medications"></span></div>
<div class="form-field"><label asp-for="OtherInformation">@T["Other relevant information"]</label><textarea asp-for="OtherInformation" rows="3" maxlength="2000"></textarea><span asp-validation-for="OtherInformation"></span></div>
<div class="form-field"><label asp-for="Instructions">@T["Instructions for responders"]</label><textarea asp-for="Instructions" rows="3" maxlength="2000"></textarea><span asp-validation-for="Instructions"></span></div>
</div><label class="check-label consent-box"><input asp-for="HealthConsent" /><span>@T[Privacy.Value.HealthConsentTextPublic] <a href="/privacy">@T["Privacy notice"]</a> (@Privacy.Value.PolicyVersion)</span></label><span asp-validation-for="HealthConsent"></span></section>
<section class="card"><h2>@T["What a helmet scan reveals"]</h2><p>@T["Anyone who scans, photographs, or receives your sticker URL can see the selected fields. Unselected fields remain available only in your account."]</p><fieldset class="visibility-grid"><legend class="sr-only">@T["Public emergency fields"]</legend>
@foreach (var field in Enum.GetValues<PublicFields>().Where(x => x != PublicFields.None))
{
    var label = field switch { PublicFields.Name => "Full name", PublicFields.Photo => "Profile photo", PublicFields.Age => "Age", PublicFields.BloodType => "Blood type", PublicFields.Allergies => "Allergies", PublicFields.Conditions => "Medical conditions", PublicFields.Medications => "Current medications", PublicFields.OtherInformation => "Other relevant information", PublicFields.Instructions => "Instructions for responders", PublicFields.Contacts => "Emergency contact names and permitted phone numbers", _ => field.ToString() };
    <label class="check-label visibility-option"><input type="checkbox" name="VisibleFields" value="@field" checked="@Model.VisibleFields.Contains(field)" /> <span>@T[label]</span></label>
}
</fieldset><span asp-validation-for="VisibleFields"></span><p class="field-help">@T["Contact email addresses are never published. A phone number appears only when its contact also allows public phone visibility."]</p></section>
<div class="form-actions sticky-actions"><button class="btn btn-primary" type="submit">@T["Save profile"]</button><a class="btn btn-outline" href="/profile">@T["Cancel"]</a></div>
</form>
@if (Model.HealthConsent) { <section class="card danger-zone"><h2>@T["Withdraw health consent"]</h2><p>@T["This immediately deletes all health fields and removes their public visibility. Your account, identity details and stickers remain available."]</p><form asp-action="WithdrawConsent" method="post"><button class="btn btn-danger-outline" type="submit">@T["Withdraw consent and delete health information"]</button></form></section> }
