@model ProfileDashboardModel
@{ ViewData["Title"] = T["Your rider dashboard"]; }
<div class="page-header"><div><span class="eyebrow">@T["RIDER SPACE"]</span><h1>@T["Your rider dashboard"]</h1><p>@T["Your emergency readiness, at a glance."]</p></div><a class="btn btn-primary" href="/profile/edit">@T["Edit emergency profile"]</a></div>
<div class="stat-grid"><div class="card stat-card"><span class="stat-label">@T["Active stickers"]</span><strong>@Model.Identifiers.Count(x => x.IsActive)</strong><a href="/stickers">@T["Manage QR & NFC"] →</a></div><div class="card stat-card"><span class="stat-label">@T["Ready contacts"]</span><strong>@Model.VerifiedContactCount <small>/ @Model.ContactCount</small></strong><a href="/contacts">@T["Manage contacts"] →</a></div><div class="card stat-card"><span class="stat-label">@T["Published fields"]</span><strong>@(Enum.GetValues<PublicFields>().Count(x => x != PublicFields.None && Model.Profile.PublicFields.HasFlag(x)))</strong><a href="/profile/edit">@T["Review privacy"] →</a></div></div>
<div class="dashboard-grid"><section class="card"><div class="card-heading"><h2>@T["Emergency profile"]</h2><span class="badge">@(Model.Profile.HealthConsent ? T["Health consent active"] : T["Health details private"])</span></div><div class="profile-summary">@if (Model.Profile.PhotoFileName is not null) { <img class="rider-avatar" src="/profile/photo" alt="@T["Your profile photo"]" /> } else { <span class="avatar-placeholder" aria-hidden="true">@Model.Profile.FullName.FirstOrDefault()</span> }<div><h3>@Model.Profile.FullName</h3><p class="text-muted">@T["Last updated"] @TimeZoneInfo.ConvertTime(Model.Profile.UpdatedAt, TimeZoneInfo.FindSystemTimeZoneById("Europe/Athens")).ToString("dd MMM yyyy")</p></div></div><p>@T["A sticker scan shows only the fields you publish. Medical information is rider supplied."]</p><div class="form-actions"><a href="/profile/edit" class="btn btn-outline">@T["Edit profile"]</a>@if (Model.PreviewUrl is not null) { <a class="btn btn-primary" href="@Model.PreviewUrl">@T["Preview emergency page"]</a> } else { <a class="btn btn-primary" href="/stickers">@T["Create your first sticker"]</a> }</div></section>
<section class="card"><h2>@T["Ready for the road"]</h2><ul class="readiness-list"><li>@(Model.Profile.FullName.Length > 0 ? "✓" : "○") @T["Keep your personal information current."]</li><li>@(Model.VerifiedContactCount > 0 ? "✓" : "○") @T["Ask a trusted contact to confirm their email."]</li><li>@(Model.Identifiers.Any(x => x.IsActive) ? "✓" : "○") @T["Attach an active QR or NFC sticker to your helmet."]</li><li>✓ @T["Choose exactly what helpers can see."]</li></ul><p class="field-help">@T["ScanBack helps people contact your emergency contacts. It does not call emergency services automatically."]</p></section></div>
<section class="card"><div class="card-heading"><h2>@T["Your stickers"]</h2><a href="/stickers">@T["View all"] →</a></div>@if (!Model.Identifiers.Any()) { <div class="empty-state"><h3>@T["No stickers yet"]</h3><p>@T["Generate your first QR code and NFC-compatible URL."]</p><a class="btn btn-primary" href="/stickers">@T["Manage QR & NFC"]</a></div> } else { <div class="table-responsive"><table class="table"><thead><tr><th>@T["Label"]</th><th>@T["Status"]</th><th>@T["Created"]</th></tr></thead><tbody>@foreach (var sticker in Model.Identifiers.Take(5)) { <tr><td>@sticker.Label</td><td><span class="badge @(sticker.IsActive ? "badge-success" : "badge-muted")">@(sticker.IsActive ? T["Active"] : T["Inactive"])</span></td><td>@TimeZoneInfo.ConvertTime(sticker.CreatedAt, TimeZoneInfo.FindSystemTimeZoneById("Europe/Athens")).ToString("dd MMM yyyy")</td></tr> }</tbody></table></div> }</section>
<section class="card"><h2>@T["Your data, your choice"]</h2><p>@T["Download your personal data or permanently delete your account."]</p><div class="form-actions"><a class="btn btn-outline" href="/profile/export">@T["Export my data"]</a><a class="btn btn-danger-outline" href="/profile/delete">@T["Delete account"]</a></div></section>
