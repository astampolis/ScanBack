@model IncidentJoinViewModel
@{ ViewData["Title"] = T["Private incident invitation"]; var expiryTime = TimeZoneInfo.ConvertTime(Model.ExpiresAt, TimeZoneInfo.FindSystemTimeZoneById("Europe/Athens")); }
<header class="page-header"><span class="eyebrow">@T["PRIVATE INCIDENT INVITATION"]</span><h1>@T["A possible accident was reported"]</h1><p>@Model.DisplayName</p></header>
<div class="call-grid"><a href="tel:112" class="btn btn-danger call-button"><strong>112</strong><span>@T["European Emergency Number"]</span></a><a href="tel:166" class="btn btn-danger call-button"><strong>166</strong><span>@T["Ambulance Service · Greece"]</span></a></div>
<section class="card">
    <h2>@T["Open the reported incident"]</h2>
    <p>@T["This report is unverified. ScanBack has not contacted emergency services."]</p>
    <p>@T["Your invitation gives temporary access to one incident and its reported location. Do not forward this invitation."]</p>
    <p class="field-help">@T["Access expires"]: <time datetime="@Model.ExpiresAt.ToString("O")">@expiryTime.ToString("dd MMM yyyy HH:mm") (Europe/Athens)</time></p>
    <form method="post" action="/incident/join/@Model.Token">@Html.AntiForgeryToken()<button type="submit" class="btn btn-primary btn-wide">@T["Open private incident page"]</button></form>
</section>
