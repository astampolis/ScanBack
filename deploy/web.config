<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath=".\ScanBack.Web.exe" arguments="" stdoutLogEnabled="false" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <environmentVariable name="DOTNET_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
      <security>
        <requestFiltering removeServerHeader="true">
          <requestLimits maxAllowedContentLength="3145728" />
          <verbs><remove verb="TRACE" /><add verb="TRACE" allowed="false" /></verbs>
        </requestFiltering>
      </security>
      <httpProtocol><customHeaders><remove name="X-Powered-By" /></customHeaders></httpProtocol>
      <httpErrors errorMode="Custom" existingResponse="PassThrough" />
    </system.webServer>
  </location>
</configuration>
