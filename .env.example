# Configuration names only; ASP.NET does not automatically load this file.
# Never commit credentials. See deploy/appsettings.Production.example.json and docs/iis-deployment.md.
ASPNETCORE_ENVIRONMENT=Production
DOTNET_ENVIRONMENT=Production
# Windows IIS/Worker: protect this external JSON and set this path on BOTH hosts.
# SCANBACK_CONFIG_FILE=C:\ProgramData\ScanBack\config\appsettings.Production.json
# Linux/container paths below require protected persistent mounts and a separately hosted worker.
Site__BaseUrl=https://your-domain.example
AllowedHosts=your-domain.example
ConnectionStrings__DefaultConnection=Server=your-sql-host;Database=ScanBack;User Id=scanback;Password=SET_SECURELY;Encrypt=true;TrustServerCertificate=false;
Encryption__KeyDirectory=/var/scanback/keys
Storage__PhotoDirectory=/var/scanback/photos
Encryption__CertificatePath=/run/secrets/data-protection.pfx
Encryption__CertificatePassword=SET_SECURELY
# On Windows use a separate RSA certificate in LocalMachine/My instead of a PFX:
# Encryption__CertificateThumbprint=REPLACE_ME_WITH_DATA_PROTECTION_CERTIFICATE_THUMBPRINT
# Retain old machine-store certificates/private keys during rotation:
# Encryption__DecryptionCertificateThumbprints__0=REPLACE_ME_WITH_PREVIOUS_CERTIFICATE_THUMBPRINT
Privacy__ControllerName=REPLACE_ME_WITH_LEGAL_OPERATOR_NAME
Privacy__ContactEmail=privacy@your-domain.example
Privacy__PolicyVersion=REPLACE_ME_WITH_APPROVED_POLICY_VERSION
Mail__Enabled=true
Mail__Host=smtp.your-provider.example
Mail__Port=587
Mail__UseStartTls=true
Mail__FromEmail=alerts@your-domain.example
Mail__FromName=ScanBack
Mail__Username=SET_SECURELY
Mail__Password=SET_SECURELY
# Provision ONLY in the separate operator process: ScanBack.Deployment create-admin --config <absolute-json>.
# Never put these in shared JSON, IIS/service environment, shell history or the release package.
# Admin__Email=your-administrator@example.com
# Admin__Password=SET_SECURELY
# If required, inject ConnectionStrings__DeploymentConnection ONLY into the migration operator process.
# Production Web/Worker reject privileged SQL identities and exposed DeploymentConnection settings.
# Same-host Windows integrated SQL authentication is recommended; CLI uses the operator's Windows identity.
# For a separately hosted reverse proxy, trust only its explicit IP; IIS integration handles its own forwarding.
# ForwardedHeaders__TrustedProxies__0=127.0.0.1
